.app-content-header
  .container-fluid
    .row
      .col-sm-6
        %h3.mb-0 Add New Operator
.app-content
  .container-fluid
    .row
      .col-sm-6
        .card
          .card-body
            = form_with model: [:admin, @operator], local: true do |f|
              = render "shared/error_messages", object: f.object
              = render "form", f: f
              = f.submit "Create Operator", class: "btn btn-primary"
              = link_to "Back", admin_operators_path, class: "btn btn-secondary"