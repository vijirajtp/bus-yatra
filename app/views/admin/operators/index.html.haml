.app-content-header
  .container-fluid
    .row
      .col-sm-6
        %h3.mb-0 Operators
.app-content
  .container-fluid
    = link_to "New Operator", new_admin_operator_path, class:"btn btn-primary mb-3"
    %table.table.table-bordered
      %tr
        %th Name
        %th User
        %th Created At
        %th Actions
      %tbody
        - if @operators.any?
          - @operators.each do |op|
            %tr
              %td= op.name
              %td= op.user.email
              %td= op.created_at.strftime("%d-%m-%Y %H:%M %p")
              %td= link_to "Edit", edit_admin_operator_path(op)
          = will_paginate @operators
        - else
          %tr
            %td{colspan: "3", style: "text-align:center"} No records found.