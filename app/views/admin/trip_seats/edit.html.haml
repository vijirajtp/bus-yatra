.app-content-header
  .container-fluid
    .row
      .col-sm-6
        %h3.mb-0 Edit Trip Seat
.app-content
  .container-fluid
    .row
      .col-sm-6
        .card
          .card-body
            = form_with model: [:admin, @trip, @trip_seat], local: true do |f|
              = render "form", f: f
              = f.submit "Update Trip Seat", class: "btn btn-primary"
              = link_to "Back", admin_trip_trip_seats_path(@trip), class: "btn btn-secondary"