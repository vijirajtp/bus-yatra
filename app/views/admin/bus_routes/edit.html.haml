.app-content-header
  .container-fluid
    .row
      .col-sm-6
        %h3.mb-0 Edit Route
.app-content
  .container-fluid
    .row
      .col-sm-6
        .card
          .card-body
            = form_with model: [:admin, @route], url: admin_bus_route_path(@route), local: true do |f|
              = render "form", f: f
              = f.submit "Update Route", class: "btn btn-primary"
              = link_to "Back", admin_bus_routes_path, class: "btn btn-secondary"