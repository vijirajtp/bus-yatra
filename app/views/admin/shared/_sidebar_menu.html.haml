.sidebar-brand
  %a.brand-link{href: "#{root_path}"}
    %img.brand-image.opacity-75.shadow{alt: "Bus Yatra Logo", src: "#{asset_path('AdminLogo.png')}"}/
    %span.brand-text.fw-light Bus Yatra
.sidebar-wrapper
  %nav.mt-2
    %ul#navigation.nav.sidebar-menu.flex-column{"aria-label" => "Main navigation", "data-accordion" => "false", "data-lte-toggle" => "treeview", role: "navigation"}
      %li.nav-item
        %a.nav-link{href: "#{admin_dashboard_path}"}
          %i.nav-icon.bi.bi-palette
          %p Dashboard
      - if policy(Operator).index?
        %li.nav-item
          %a.nav-link{href: "#{admin_operators_path}"}
            %i.nav-icon.bi.bi-palette
            %p Operators
      - if policy(Bus).index?
        %li.nav-item
          %a.nav-link{href: "#{admin_buses_path}"}
            %i.nav-icon.bi.bi-palette
            %p Buses
      - if policy(Route).index?
        %li.nav-item
          %a.nav-link{href: "#{admin_bus_routes_path}"}
            %i.nav-icon.bi.bi-palette
            %p Routes
      - if policy(Trip).index?
        %li.nav-item
          %a.nav-link{href: "#{admin_trips_path}"}
            %i.nav-icon.bi.bi-palette
            %p Trips