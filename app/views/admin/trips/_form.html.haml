.mb-3
  = f.label :route_id, "Route"
  = f.collection_select :route_id, Route.all, :id, ->(r) { "#{r.from_city} ➝ #{r.to_city}" }, {}, { class: "form-control" }
.mb-3
  = f.label :operator_id, "Operator"
  = f.collection_select :operator_id, Operator.all, :id, :name, {}, { class: "form-control" }
.mb-3
  = f.label :bus_id, "Bus"
  = f.collection_select :bus_id, Bus.all, :id, :name, {}, { class: "form-control" }
.mb-3
  = f.label :travel_date, "Travel Date"
  = f.date_field :travel_date, class: "form-control"
.mb-3
  = f.label :departure_at, "Departure Date & Time"
  = f.datetime_local_field :departure_at, class: "form-control"
.mb-3
  = f.label :price, "Price (₹)"
  = f.number_field :price, step: 100, class: "form-control"