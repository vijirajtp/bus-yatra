.app-content-header
  .container-fluid
    .row
      .col-sm-6
        %h3.mb-0 Dashboard
.app-content
  .container-fluid
    .row
      .col-lg-3.col-6
        .small-box.text-bg-primary
          .inner
            %h3= @total_trips
            %p Trips
      .col-lg-3.col-6
        .small-box.text-bg-success
          .inner
            %h3= @total_routes
            %p Routes
      .col-lg-3.col-6
        .small-box.text-bg-warning
          .inner
            %h3= @total_buses
            %p Buses
      .col-lg-3.col-6
        .small-box.text-bg-danger
          .inner
            %h3= @total_bookings
            %p Bookings