!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Bus Yatra - Ticket Booking"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "yes", :name => "apple-mobile-web-app-capable"}/
    %meta{:content => "Bus Yatra - Ticket Booking", :name => "application-name"}/
    %meta{:content => "yes", :name => "mobile-web-app-capable"}/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{:href => "/icon.png", :rel => "icon", :type => "image/png"}/
    %link{:href => "/icon.svg", :rel => "icon", :type => "image/svg+xml"}/
    %link{:href => "/icon.png", :rel => "apple-touch-icon"}/
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
    %script{crossorigin: "anonymous", src: "https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/js/adminlte.min.js"}
    %link{crossorigin: "anonymous", href: "https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc3/dist/css/adminlte.min.css", rel: "stylesheet"}/
  %body.layout-fixed.sidebar-expand-lg.sidebar-open.bg-body-tertiary
    .app-wrapper
      %nav.app-header.navbar.navbar-expand.bg-body
        = render partial: "admin/shared/navbar"
      %aside.app-sidebar.bg-body-secondary.shadow{"data-bs-theme" => "dark"}
        = render partial: "admin/shared/sidebar_menu"
      %main.app-main
        / Flash Messages
        .container
          - flash.each do |type, message|
            - alert_class = type == "notice" ? "alert-success" : "alert-danger"
            .alert.alert-dismissible.fade.show.mt-2{class: alert_class, role: "alert"}
              = message
              %button.btn-close{type: "button", "data-bs-dismiss": "alert", "aria-label": "Close"}
        = yield
      %footer.app-footer
        .float-end.d-none.d-sm-inline Bus Yatra
        %strong
          Copyright © #{Time.current.year}
          = succeed "." do
            %a.text-decoration-none{href: "#"} Bus Yatra
        All rights reserved.